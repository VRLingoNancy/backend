// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  moderator
  tester
}

enum CEFRLevel {
  A1
  A1Plus
  A2
  A2Plus
  B1
  B1Plus
  B2
  B2Plus
  C1
  C2
}

enum Sender {
  USER
  AI
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String
  username      String?          @unique
  role          Role             @default(user)     
  isVerified    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastLogin     DateTime?
  deletedAt     DateTime?

  settings      UserSettings?
  languages     UserLanguage[]
  IAUsageLog IAUsageLog[]
  conversations Conversation[]

  @@map("users")
  AuthToken AuthToken[]
  IACredit IACredit[]
}


model UserSettings {
  userId                String   @id
  nativeLanguageCode    String // Langue maternelle de l'utilisateur
  interfaceLanguageCode String // Langue de l'interface utilisateur
  preferredStudyLanguage String? // Langue d'étude préférée
  defaultIaModel        String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserLanguage {
  userId       String
  languageCode String
  initialLevel CEFRLevel

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, languageCode])
  @@map("user_languages")
}

model AuthToken {
  id               String   @id @default(uuid())
  userId           String
  refreshToken     String   @unique
  refreshExpiresAt DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model IACredit {
  userId           String   @id
  creditsAvailable Int      @default(0)
  creditsUsed      Int      @default(0)
  lastReset        DateTime?
  limitStrategy    String   @default("manual") // ex : "manual", "monthly", "subscription"
  pendingRecharge  Boolean  @default(false)
  lastUsageAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ia_credits")
}

model IAUsageLog {
  id            String   @id @default(uuid())
  userId        String
  timestamp     DateTime @default(now())
  tokenCost Decimal  @db.Decimal(10, 8)
  model         String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  message       Message?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ia_usage_logs")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String? // Titre de la conversation, ex: "Au restaurant"
  languageCode  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[] // Une conversation a plusieurs messages

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  sender         Sender   // 'USER' ou 'AI'
  content        String   @db.Text // Le contenu texte du message
  createdAt      DateTime @default(now())

  // Relation optionnelle vers le log d'usage (uniquement pour les messages de l'IA)
  iaUsageLogId   String?  @unique
  iaUsageLog     IAUsageLog? @relation(fields: [iaUsageLogId], references: [id])

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}